PORT=4000
# Shown to panels inside image and share URLs. Use a LAN address the Android panel can reach.
PUBLIC_API_URL=http://localhost:4000
ADMIN_ORIGIN=http://localhost:5173
SHARE_WEB_ORIGIN=http://localhost:5174
WHITEBOARD_WEB_ORIGIN=http://10.23.252.71:5175
# One domain: PUBLIC_API_URL, SHARE_WEB_ORIGIN, and WHITEBOARD_WEB_ORIGIN are the site
# origin. ADMIN_ORIGIN is that origin plus /admin. Share and whiteboard links are /<code>.
ADMIN_PASSWORD=change-me

# Google Calendar connection. Redirect must match the Cloud console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/oauth/google/callback

# Microsoft 365 connection. Redirect must match the app registration.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:4000/api/oauth/microsoft/callback

# Optional TURN. Without it, screen share works on the same LAN only.
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=
