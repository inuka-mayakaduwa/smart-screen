# Local `docker compose up` loads this after deploy/.env.example and before deploy/.env.
# No domain is required. localhost is this computer's browser only.
# The Android emulator and a phone on the network cannot open it.
# Put this PC's LAN address in deploy/.env for PUBLIC_API_URL, SHARE_WEB_ORIGIN,
# and WHITEBOARD_WEB_ORIGIN, for example http://192.168.1.15:4000.
# From the Android emulator, 10.0.2.2 is this computer if the LAN address does not answer.

PUBLIC_API_URL=http://localhost:4000
ADMIN_ORIGIN=http://localhost:5173
SHARE_WEB_ORIGIN=http://localhost:5174
WHITEBOARD_WEB_ORIGIN=http://localhost:5175
GOOGLE_REDIRECT_URI=http://localhost:4000/api/oauth/google/callback
MICROSOFT_REDIRECT_URI=http://localhost:4000/api/oauth/microsoft/callback
